# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Ключ Claude API (https://console.anthropic.com). Без него чат отвечает «сервис недоступен».
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Для запуска бэкенда без Docker. В docker compose адрес БД задаётся автоматически.
DATABASE_URL=postgresql+asyncpg://legal:legal@localhost:5432/legal
CORS_ORIGINS=http://localhost:3000
